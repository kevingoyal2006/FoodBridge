# ==========================================
# FoodBridge - Environment Configuration Example
# Copy this file to server/.env and client/.env
# ==========================================

# --- Server Settings (server/.env) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge
CLIENT_ORIGIN=http://localhost:5173

# --- Authentication & Security ---
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=foodbridge_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Frontend Settings (client/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
